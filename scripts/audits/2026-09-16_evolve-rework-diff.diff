+    det.push(`④B1向量(registry错误面):${b1Ok ? '全过' : '✗'} ${b1Det.join('；')}`)
+  }
   if (!keepTmp) rmSync(r10tmp, { recursive: true, force: true })
   record('R10', ok, `b1/b2/b6 回归面——${det.join('；')}`)
 }
